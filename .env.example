# Copy to `.env` and adjust as needed.

# --- LOCAL DEVELOPMENT (SQLite) ---
# SQLite database file, resolved relative to the project root.
DATABASE_URL="file:./dev.db"

# --- PRODUCTION DEPLOYMENT (Turso Cloud SQLite) ---
# For Vercel/Production, create a free database at https://turso.tech
# DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# Optional. When set, the cron routes require `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="change-me-to-a-secure-random-string"

# Optional. Set to "1" to point the app at a staging database.
# NODE_ENV="development"

